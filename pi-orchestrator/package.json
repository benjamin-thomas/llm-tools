{
  "name": "pi-orchestrator",
  "version": "0.1.0",
  "description": "Turn a Pi session into an orchestrator for multiple live native workers",
  "type": "module",
  "private": true,
  "license": "MIT",
  "files": [
    "src",
    "skills",
    "README.md"
