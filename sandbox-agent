#!/usr/bin/ruby

# Symlink to your ~/.local/bin/ directory
#
# The system ruby, not `env ruby`: a version manager's ruby (rbenv and the like)
# may live in a directory a sandbox can write, and this script runs on the host.

# --- Deliberately NOT granted — do not re-add ---
#
# Every mount is a hole in the sandbox. The ones below were big enough to hand
# an agent the host itself, so they are gone on purpose. A broken tool is the
# cheaper trade — if something needs one of these, the answer is no.
#
#   SSH, in every form: ~/.ssh (hidden by the tmpfs home), SSH_AUTH_SOCK, the
#   gnome-keyring and gpg-agent ssh sockets, the ssh/scp/sftp binaries. An
#   agent holding an ssh agent socket can log into every host you can.
#
#   GnuPG and the password store: ~/.gnupg, ~/.password-store and the host
#   gpg-agent socket dir (/run/user/<uid>/gnupg). The host agent holds the
#   unlocked key, so with its socket an agent decrypts every pass entry the
#   moment the passphrase is cached — or pops a pinentry you would answer,
#   thinking it is your own. They were only here for commit signing; sign on
#   the host instead.
#
#   The host network. A sandbox has its own (--unshare-net): no route to
#   whatever the host reaches, no ssh tunnel left open on localhost, no
#   abstract unix socket. The way out is a logging proxy run from here, plus
#   the host services a project declares with host: — see sandbox-network.rb.
#
#   The session D-Bus socket (/run/user/<uid>/bus). It is the Secret Service
#   API: KWallet and gnome-keyring hand out saved passwords over it. This —
#   not the X11 passthrough — is how an agent ends up talking to kwalletd.
#
#   The gnome-keyring socket dir (/run/user/<uid>/keyring): same secrets, plus
#   its ssh agent.
#
#   XDG_CURRENT_DESKTOP / XDG_SESSION_TYPE / DESKTOP_SESSION: their only job
#   was helping Electron apps find an OS keyring, i.e. the thing above.
#
#   The host X server: /tmp/.X11-unix, the cookie, DISPLAY. Any X client can
#   read every keystroke, capture the screen, and type into a host terminal
#   (XTEST) — an escape as complete as an ssh socket. Hiding the socket is not
#   enough, either: Xorg also listens on an abstract socket. Network namespace
#   isolation blocks that socket; the cookie remains hidden, and the GNOME
#   `xhost +SI:localuser` rule is revoked at every launch. See sandbox-x11.rb.
#
#   What replaces it: a private Xephyr screen per session (Chrome shows up
#   there, and nothing in it can reach the host's windows), and a bridge for
#   the CLIPBOARD selection only — text and images, both ways.
#
# .sandbox-mounts cannot quietly re-add them: that file lives in the project the
# agent can write, so it authorizes nothing by itself — it requests, and you
# approve with `sandbox-agent allow`. See the "Mount approval" comment in
# sandbox-lib.rb for why this is an approval step and not a denylist.
#
# Still granted, for the record: the CLIPBOARD selection through the bridge
# (an agent can read whatever you copy there, at any time — set
# PASSWORD_STORE_X_SELECTION=primary to keep `pass -c` out of it), ~/.cache rw,
# ~/.local ro, audio devices, the project dir rw.

require "fileutils"
require "json"
require "open3"
require "optparse"
require "shellwords"
require "tmpdir"

# The mount set and the .sandbox-mounts contract live in the lib. What is here
# is what only an interactive agent session needs: the multiplexer, and the
# flags that drive it.
require_relative "sandbox-lib"
require_relative "sandbox-network"

# module_function also defines these as private instance methods, so the
# multiplexer block below can keep calling ro/rw unqualified.
include SandboxLib

flags = { mux: "herdr", gui: true, write: false, setenv: [], git_write: false, shares: [] }

# `doctor` is a subcommand, not a flag: it takes a project dir and no command.
if (allow = ARGV.first == "allow")
  ARGV.shift
end
# `share-path <project-dir> <name>`: where the host side of a share lives, for
# the script that writes or reads it. Created, so it can be filled before launch.
if ARGV.first == "share-path"
  abort "Usage: sandbox-agent share-path <project-dir> <name>" unless ARGV.size == 3
  source = begin
    SandboxLib.share_source(File.expand_path(ARGV[1]), ARGV[2])
  rescue ArgumentError => e
    abort e.message
  end
  FileUtils.mkdir_p(source, mode: 0o700)
  puts source
  exit
end

if (doctor = ARGV.first == "doctor")
  ARGV.shift
  # `doctor <dir> --write` is the natural order to type, but OptionParser#order!
  # stops at the first positional and would never see the flag. Take it out here
  # so either order works; the parser entry below still handles the other one.
  flags[:write] = true unless ARGV.delete("--write").nil?
end

opam_switch = SandboxLib.detect_opam_switch
opam_path_line = opam_switch ? "path:~/.opam/#{opam_switch}/bin" : "path:~/.opam/<switch>/bin   # e.g. ~/.opam/5.3.0/bin"

parser = OptionParser.new do |opts|
  opts.banner = "Usage: sandbox-agent [flags] <project-dir> -- <command...>"
  opts.separator ""
  opts.separator "Run a CLI agent in a bwrap sandbox. Restricts file access to the"
  opts.separator "project directory only — the agent cannot read or modify anything"
  opts.separator "else under $HOME."
  opts.separator ""

  opts.on("--mux MUX", %w[herdr tmux],
          "Multiplexer for the sandboxed session: herdr (default) or tmux") { |mux| flags[:mux] = mux }
  opts.on("--[no-]gui", "Private Xephyr screen for GUI apps, e.g. Chrome (default: on).",
          "With --no-gui, Xvfb provides the clipboard without a window") { |gui| flags[:gui] = gui }
  opts.on("--write", "doctor only: append the missing declarations it found") { flags[:write] = true }
  opts.on("--setenv PAIR", "Extra env var as KEY=VALUE (repeatable)") { |pair| flags[:setenv] << pair }
  opts.on("--git-write", "Let this session commit, without asking: config, hooks and",
          "the other worktrees stay read-only (see \"Git write access\" in sandbox-lib.rb)") { flags[:git_write] = true }
  opts.on("--ip IP", "The session's own address: keep only it among the host: and expose:",
          "doors .sandbox-mounts declares (it narrows them, never adds)") { |ip| flags[:only_ip] = ip }
  opts.on("--share NAME:MODE", "Mount the host folder `sandbox-agent share-path <project> NAME`",
          "at <project>/.sandbox-shares/NAME, MODE ro or rw (repeatable). Gitignore",
          ".sandbox-shares/. See \"Shares\" in sandbox-lib.rb") { |spec| flags[:shares] << spec }

  opts.separator ""
  opts.separator "Subcommands:"
  opts.separator "  sandbox-agent allow [<project-dir>]   (default: the current directory)"
  opts.separator "    Approve the project's .sandbox-mounts after reading it. Required"
  opts.separator "    before a first launch, and again after any change to the file —"
  opts.separator "    it lives in the project, so an agent can edit it."
  opts.separator ""
  opts.separator "  sandbox-agent share-path <project-dir> <name>"
  opts.separator "    Print (and create) the host side of a --share, for the script"
  opts.separator "    that fills or reads it."
  opts.separator ""
  opts.separator "  sandbox-agent doctor <project-dir> [--write]"
  opts.separator "    Report what this project must declare in .sandbox-mounts before it"
  opts.separator "    will run: symlinks that leave the project (which are never mounted"
  opts.separator "    implicitly) plus advisory toolchain recipes. Exits 1 if anything is"
  opts.separator "    undeclared, so it works as a pre-flight check."
  opts.separator ""
  opts.separator "Never available inside the sandbox, by design (see the header comment"
  opts.separator "before re-adding any of it):"
  opts.separator "  SSH — no keys, no agent socket, no ssh/scp/sftp binaries"
  opts.separator "  Session D-Bus + gnome-keyring — the KWallet/Secret Service password API"
  opts.separator "  The host multiplexer server — see the --mux note below"
  opts.separator "  The host X server — no access to your windows, keystrokes or screen"
  opts.separator ""
  opts.separator "GUI apps get a private screen instead: one Xephyr window per session,"
  opts.separator "titled after the project, that Chrome and its windows follow on resize."
  opts.separator "It starts minimized on the last workspace; bring it back from the dock."
  opts.separator "CLIPBOARD (not PRIMARY) is relayed both ways, for text and images,"
  opts.separator "including native clipboard access in Codex and ordinary xclip calls."
  opts.separator "Data is read on demand, in memory only, with no history or focus requirement;"
  opts.separator "clearing or replacing the source invalidates the relayed content."
  opts.separator ""
  opts.separator "The agent always runs inside a sandboxed multiplexer server so sub-agent"
  opts.separator "panes stay confined. Ctrl-o is the prefix either way (with tmux,"
  opts.separator "Alt-left/right switch windows)."
  opts.separator ""
  opts.separator "The default is herdr, which shows per-pane agent state (working /"
  opts.separator "idle / blocked). Its server is reached over a socket that can start"
  opts.separator "processes for whoever holds it, so the sandbox gets a private one via"
  opts.separator "HERDR_SOCKET_PATH and ~/.config/herdr is never mounted — handing an"
  opts.separator "agent the host socket would be a full sandbox escape."
  opts.separator ""
  opts.separator "--mux tmux swaps herdr back for tmux."
  opts.separator ""
  opts.separator "herdr launches made from inside a host tmux session are recorded in"
  opts.separator "~/.sandbox-agent/herdr-registry (removed on exit) so the host-side companion"
  opts.separator "`herdr-hub` can flag which tmux session's agent needs attention."
  opts.separator ""
  opts.separator "Examples:"
  opts.separator "  sandbox-agent . -- claude-yolo"
  opts.separator "  sandbox-agent /path/to/project -- codex-yolo"
  opts.separator ""
  opts.separator "Low-intervention \"yolo\" wrappers (see ~/.local/bin/*-yolo):"
  opts.separator "  sandbox-agent . -- claude-yolo"
  opts.separator "  sandbox-agent . -- codex-yolo"
  opts.separator "  sandbox-agent . -- kimi -y"
  opts.separator "  sandbox-agent . -- grok --always-approve"
  opts.separator "  sandbox-agent . -- opencode       # already yolo by default"
  opts.separator "  sandbox-agent . -- pi             # already yolo by default"
  opts.separator "  sandbox-agent . -- omp            # already yolo by default"
  opts.separator "  sandbox-agent . -- prime-agent    # already yolo by default"
  opts.separator ""
  opts.separator "Auto-mounted when present on the host (no .sandbox-mounts needed):"
  opts.separator "  Chrome/Chromium install dir — for projects driving a CDP browser"
  opts.separator "  /dev/shm tmpfs              — required by Chrome and many tools"
  opts.separator "  Go toolchain + GOPATH       — tracks whichever `go` is on your PATH"
  opts.separator ""
  opts.separator "Projects can provide a .sandbox-mounts file for extra mounts:"
  opts.separator "  ro:/path          — read-only mount"
  opts.separator "  rw:/path          — read-write mount"
  opts.separator "  path:/path/bin    — add to PATH"
  opts.separator "  (leading ~ is expanded to $HOME)"
  opts.separator ""
  opts.separator "Network: the sandbox has a private network, with no way out but the"
  opts.separator "doors declared in the same file (approved with `allow`, like mounts):"
  opts.separator ""
  opts.separator "  internet:HOST           sandbox -> internet. The sandbox may reach this"
  opts.separator "                          site (HTTP/HTTPS, through a proxy). A name covers"
  opts.separator "                          its subdomains. Adds to the list every project"
  opts.separator "                          gets: ~/.sandbox-agent/internet-allowlist"
  opts.separator "                          Applies at once, running sessions included."
  opts.separator "                          e.g. internet:guides.rubyonrails.org"
  opts.separator ""
  opts.separator "  host:IP:PORT[,PORT]     sandbox -> host. The sandbox may connect to this"
  opts.separator "                          service on the host (your machine), any protocol."
  opts.separator "                          IP/PREFIX covers a range of dev IPs."
  opts.separator "                          Applies at the next launch."
  opts.separator "                          e.g. host:127.1.0.2:5432 (dev Postgres)"
  opts.separator ""
  opts.separator "  expose:IP:PORT[,PORT]   host -> sandbox. The sandbox exposes this server"
  opts.separator "                          it runs, so the host (your browser) reaches it."
  opts.separator "                          Applies at the next launch."
  opts.separator "                          e.g. expose:127.1.0.1:3000 (dev server)"
  opts.separator ""
  opts.separator "  Every request out is logged in ~/.sandbox-agent/network-log/."
  opts.separator ""
  opts.separator "Typical .sandbox-mounts recipes (lines below are copy-paste ready):"
  opts.separator ""
  opts.separator "# Haskell (ghcup + cabal)"
  opts.separator "rw:~/.ghcup             # ghcup writes logs/, cache/, tmp/, trash/ (tui needs rw)"
  opts.separator "path:~/.ghcup/bin       # ghc, cabal, hls all live here"
  opts.separator "rw:~/.config/cabal      # cabal config (XDG layout; classic setups: rw:~/.cabal)"
  opts.separator "rw:~/.local/state/cabal # cabal store/logs — overrides the ro ~/.local mount"
  opts.separator "# (the package cache ~/.cache/cabal is auto-mounted)"
  opts.separator ""
  opts.separator "# OCaml (opam)"
  opts.separator "ro:~/.opam"
  opts.separator opam_path_line
  opts.separator ""
  opts.separator "# Node — nvm"
  opts.separator "ro:~/.nvm"
  opts.separator "path:~/.nvm/versions/node/<version>/bin"
  opts.separator ""
  opts.separator "# Node — volta"
  opts.separator "ro:~/.volta"
  opts.separator "path:~/.volta/bin"
  opts.separator ""
  opts.separator "# Node — fnm"
  opts.separator "ro:~/.local/share/fnm"
  opts.separator "path:~/.local/share/fnm/aliases/default/bin"
  opts.separator ""
  opts.separator "# Rust (rustup + cargo)"
  opts.separator "ro:~/.rustup"
  opts.separator "rw:~/.cargo            # cargo writes to registry/cache; use ro: if you prefer"
  opts.separator "path:~/.cargo/bin"
  opts.separator ""
  opts.separator "# Go — auto-detected from your PATH; no entry needed (see list above)"
  opts.separator ""
  opts.separator "# Python — pyenv"
  opts.separator "ro:~/.pyenv"
  opts.separator "path:~/.pyenv/shims"
  opts.separator "path:~/.pyenv/bin"
  opts.separator ""
  opts.separator "# Python — uv"
  opts.separator "rw:~/.cache/uv         # uv needs a writable cache"
  opts.separator "ro:~/.local/share/uv"
  opts.separator "path:~/.local/bin"
  opts.separator ""
  opts.separator "# Python — pipx"
  opts.separator "ro:~/.local/pipx"
  opts.separator "path:~/.local/bin"
end


begin
  parser.order!
rescue OptionParser::ParseError => e
  abort "#{e.message}\n\n#{parser.help}"
end
# `allow` may be given without a path: approving the project you are standing in
# is the common case, and cwd is unambiguous there — unlike a launch, where a
# bare argument could just as well be the command.
project_dir = File.expand_path(ARGV.shift || (allow ? Dir.pwd : abort(parser.help)))
ARGV.shift if ARGV.first == "--"
abort "No command specified.\n\n#{parser.help}" if ARGV.empty? && !doctor && !allow
cmd = ARGV.dup

# --- helpers ---

exit SandboxLib.run_doctor(project_dir, ENV.fetch("HOME"), write: flags[:write]) if doctor
exit SandboxLib.approve_mounts!(project_dir) if allow

# .sandbox-mounts is a request written by the project, not an authorization.
SandboxLib.require_mounts_approval!(project_dir, "sandbox-agent")

# Network doors the project declared (approved above). Checked now, before
# anything is created, so a bad line stops the launch with nothing to clean up.
net_lines = SandboxLib.parse_sandbox_mounts(project_dir, ENV.fetch("HOME"))
                      .select { |m| %w[host expose].include?(m[:mode]) }
net_endpoints = Hash.new { |h, k| h[k] = [] }
net_lines.each do |m|
  net_endpoints[m[:mode]].concat(SandboxNetwork.parse_endpoints(m[:path]))
rescue ArgumentError => e
  hint = m[:mode] == "host" ? "\n  (host: is a service on this machine; for a website, use internet:)" : ""
  abort "Bad line in .sandbox-mounts: #{m[:line]}\n  #{e.message}#{hint}"
end
if flags[:only_ip]
  begin
    net_endpoints.each_key { |mode| net_endpoints[mode] = SandboxNetwork.only_ip(net_endpoints[mode], flags[:only_ip]) }
  rescue ArgumentError => e
    abort "--ip: #{e.message}"
  end
end

# Shown at every launch, right where you stop to answer the .git question, until
# the PENDING items at the top of sandbox-lib.rb are done. Delete it with them.
pending = <<~TXT
  ⚠ PENDING sandbox hardening: toolchains (rbenv, nvm, ghcup, caches) are rw
    and dev servers may run on the host — sandbox-written code can still run
    outside. See PENDING in sandbox-lib.rb.
TXT
warn($stderr.tty? ? "\e[33m#{pending}\e[0m" : pending)

# Asked rather than left to memory: the answer is needed before the sandbox
# exists, and inside it the mount can no longer be changed. Without a terminal
# there is no one to ask, so .git stays read-only.
#
# --git-write answers yes for a script that starts sessions nobody watches. A
# flag is something a script, or an agent writing one, can pass on your behalf:
# that is acceptable only because writing to .git no longer reaches the host —
# config, hooks and the other worktrees stay read-only whatever the answer (see
# "Git write access" in sandbox-lib.rb). Never let this flag grant more than
# the question does.
git_rw =
  if flags[:git_write]
    true
  elsif $stdin.tty?
    $stderr.print "Let this session write to .git? [y/N] "
    %w[y yes].include?($stdin.gets.to_s.strip.downcase)
  else
    false
  end
warn(git_rw ? "Starting with .git writable (config and hooks read-only)." : "Starting with .git read-only.")

home = ENV.fetch("HOME")
args = SandboxLib.build_base_args(
  project_dir,
  git_rw: git_rw,
  command: cmd.first,
  extra_env: flags[:setenv]
)

begin
  args.concat(SandboxLib.share_args(project_dir, flags[:shares]))
rescue ArgumentError => e
  abort e.message
end

# --- sandboxed multiplexer server ---
#
# Whichever multiplexer runs, it gets a private server whose socket lives in
# socket_dir. That is not tidiness: a multiplexer server socket is a remote
# control for starting processes, so an agent that reaches the *host* server
# escapes the sandbox through it. tmux is confined via TMUX_TMPDIR, herdr via
# HERDR_SOCKET_PATH; both host sockets are additionally out of reach because
# $HOME is a tmpfs and neither /tmp nor ~/.config/herdr is mounted through.

# Under $XDG_RUNTIME_DIR rather than /tmp: that is where per-user sockets belong
# (yours alone, in memory, cleared at logout). /tmp only if it is missing.
runtime_dir = ENV["XDG_RUNTIME_DIR"]
runtime_dir = nil unless runtime_dir && File.directory?(runtime_dir)
socket_dir = Dir.mktmpdir("sandbox-agent-", runtime_dir)
args.push(*rw(socket_dir))

case flags[:mux]
when "tmux"
  # tmux never puts its socket directly in TMUX_TMPDIR — it creates a
  # tmux-<uid>/ subdirectory first. Spelling that out here keeps the attach
  # hint below copy-pasteable (the uid is unchanged inside the sandbox: we
  # unshare pid, not user).
  mux_socket = File.join(socket_dir, "tmux-#{Process.uid}", "default")
  attach_hint = "tmux -S #{mux_socket} attach"

  args.push("--setenv", "TMUX_TMPDIR", socket_dir)

  cmd = [
    "tmux", "-f", "/dev/null",
    "set", "-g", "default-terminal", "tmux-256color", ";",
    "set", "-g", "extended-keys", "on", ";",
    "set", "-g", "prefix", "C-o", ";",
    "set", "-s", "copy-command", "xclip -selection clipboard", ";",
    "bind", "C-o", "send-prefix", ";",
    "bind", "-n", "M-left", "prev", ";",
    "bind", "-n", "M-right", "next", ";",
    "bind", "-T", "copy-mode", "M-w", "send-keys", "-X", "copy-pipe-and-cancel", "xclip -selection clipboard", ";",
    "bind", "-T", "copy-mode-vi", "y", "send-keys", "-X", "copy-pipe-and-cancel", "xclip -selection clipboard", ";",
    "bind", "-T", "copy-mode-vi", "Enter", "send-keys", "-X", "copy-pipe-and-cancel", "xclip -selection clipboard", ";",
    "new-session", "-s", "sandbox", ";",
    "send-keys", cmd.shelljoin, "Enter",
  ]

when "herdr"
  mux_socket = File.join(socket_dir, "herdr.sock")
  attach_hint = "HERDR_SOCKET_PATH=#{mux_socket} herdr"

  # herdr runs default_shell for every new pane and takes no per-pane command,
  # so the agent is launched through a shim instead. First pane gets the agent
  # (what tmux's send-keys does); later panes get a plain shell, so a pane you
  # open to look around stays a shell rather than starting a second agent.
  launcher = File.join(socket_dir, "launch")
  File.write(launcher, <<~SH)
    #!/bin/sh
    if [ -e "#{socket_dir}/.launched" ]; then
      exec "${SHELL:-/bin/sh}"
    fi
    : > "#{socket_dir}/.launched"
    exec #{cmd.shelljoin}
  SH
  FileUtils.chmod(0o755, launcher)

  # There is no `herdr -f <file>` to match `tmux -f /dev/null`, so settings
  # arrive as a config bind-mounted over the path herdr reads. It is generated
  # rather than copied from the host precisely so ~/.config/herdr — which holds
  # the host server's socket — never has to be mounted.
  #
  # herdr has no "last tab" action; last_pane is the closest built-in. It is a
  # *global* back-and-forth, so returning to a pane in another tab brings that
  # tab with it, and it takes over prefix+l (focus_pane_right) to sit where
  # tmux keeps its last-window binding.
  #
  # A sandbox session is one workspace with a pane or two, so the sidebar is
  # mostly listing what is already on screen: it starts collapsed, and
  # prefix+b brings it back.
  #
  # window_title mirrors the focused agent's own OSC title out to the host
  # tmux (which records it as pane_title, visible in the expanded session
  # switcher): the working spinner for claude, "Action Required" for agents
  # that title their blocked state. The default "{hostname}: {workspace}"
  # would discard exactly that signal. Note "done" never appears in any
  # title — herdr derives it — so herdr-hub, not the title, answers that.
  config = File.join(socket_dir, "config.toml")
  File.write(config, <<~TOML)
    onboarding = false
    [keys]
    prefix = "ctrl+o"
    previous_tab = "alt+left"
    next_tab = "alt+right"
    previous_agent = "alt+up"
    next_agent = "alt+down"
    previous_workspace = "alt+shift+up"
    next_workspace = "alt+shift+down"
    last_pane = "prefix+l"
    [ui]
    sidebar_start_collapsed = true
    window_title = "{terminal_title} | {workspace}"
    [terminal]
    default_shell = "#{launcher}"
  TOML

  args.push(*ro(config, "#{home}/.config/herdr/config.toml"),
            "--setenv", "HERDR_SOCKET_PATH", mux_socket,
            "--setenv", "HERDR_CLIENT_SOCKET_PATH", File.join(socket_dir, "herdr-client.sock"))

  cmd = ["herdr"]
end

if mux_socket
  warn "Sandbox #{flags[:mux]} socket: #{mux_socket}"
  warn "Attach from another terminal:  #{attach_hint}"
  warn "---"
end

# --- clipboard bridge and private screen ---
#
# Both run on the host, for as long as the sandbox does:
# they are what replaces the host X server, which the sandbox never sees (see
# the header). --no-gui uses Xvfb: native clipboard clients still need a private
# X server. Only that server's socket and cookie go into the sandbox.

title = "sandbox: #{File.basename(File.dirname(project_dir))}/#{File.basename(project_dir)}"
screen = SandboxX11.start_screen(socket_dir, title, gui: flags[:gui] && !!ENV["DISPLAY"])
abort "Cannot launch sandbox without its private X server." unless screen
at_exit { SandboxX11.stop_screen(screen) }
args.push(*ro("/tmp/.X11-unix/X#{screen.display.delete(":")}"),
          "--setenv", "DISPLAY", screen.display,
          "--setenv", "XAUTHORITY", screen.auth)
SandboxX11.watch_screen(screen) if screen.window
clipboard_pid = SandboxX11.start_clipboard(screen)
at_exit { SandboxX11.stop_clipboard(clipboard_pid) } if clipboard_pid

# --- private network ---
#
# The sandbox has its own network namespace (--unshare-net, in the lib); these
# are its doors, served from here like the clipboard bridge. See sandbox-network.rb.

net_log = SandboxNetwork.log_path(project_dir)
mounts_file = SandboxLib.mounts_file(project_dir)
launch_mounts = File.exist?(mounts_file) ? File.read(mounts_file) : "" # approved: checked above
# The one piece of ~/.sandbox-agent a sandbox sees: its own log, read-only, so
# an agent can read why it was refused (and never another project's log).
FileUtils.mkdir_p(File.dirname(net_log))
FileUtils.touch(net_log)
args.push(*ro(net_log))
net = SandboxNetwork.start(socket_dir,
                       to_host: net_endpoints["host"].uniq,
                       expose: net_endpoints["expose"].uniq,
                       # Re-read at every request, but only ever an approved
                       # text: the file as it is now if `allow` has seen it (an
                       # agent can edit it), else as it was approved at launch.
                       allow: lambda {
                         current = File.exist?(mounts_file) && SandboxLib.mounts_approved?(project_dir) ? File.read(mounts_file) : nil
                         SandboxNetwork.allowlist(current || launch_mounts)
                       },
                       log: SandboxNetwork.logger(net_log))
net_info = File.join(socket_dir, "NETWORK.txt")
File.write(net_info, SandboxNetwork.info_text(
  host_lines: net_lines.select { |m| m[:mode] == "host" }.map { |m| m[:line] },
  expose_lines: net_lines.select { |m| m[:mode] == "expose" }.map { |m| m[:line] },
  log_path: net_log
))
File.write(net_info, "\nhost: and expose: doors narrowed to #{flags[:only_ip]} (--ip).\n", mode: "a") if flags[:only_ip]
net.env.each { |key, value| args.push("--setenv", key, value) }
args.push("--setenv", "SANDBOX_NETWORK_INFO", net_info,
          "--setenv", "SANDBOX_NETWORK_LOG", net_log)
cmd = net.wrap(cmd)

# --- host-side registry for herdr-hub ---
#
# Recorded now, on the host, because both facts stop being knowable later:
# which tmux session this launch came from (gone once bwrap starts), and where
# the sandboxed herdr socket lives (the sandbox must never learn the mapping).
# It goes under ~/.sandbox-agent, which no sandbox mounts, because herdr-hub
# feeds these values into host tmux commands, and anything under socket_dir is
# agent-writable.
if flags[:mux] == "herdr" && ENV["TMUX"]
  fmt = '#S|#{window_id}' # tmux format tokens, not Ruby interpolation
  # Without -t, display-message reports the session's current window, not the
  # caller's: a launch in a background window would record the wrong one.
  target = ENV["TMUX_PANE"] ? ["-t", ENV["TMUX_PANE"]] : []
  out, _err, tmux_status = Open3.capture3("tmux", "display-message", "-p", *target, fmt)
  session, window_id = out.strip.split("|", 2) if tmux_status.success?
  unless session.to_s.empty?
    registry_dir = File.join(home, ".sandbox-agent", "herdr-registry")
    FileUtils.mkdir_p(registry_dir)
    registry_entry = File.join(registry_dir, "#{File.basename(socket_dir)}.json")
    File.write(registry_entry, JSON.generate(
      project: project_dir,
      tmux_session: session,
      tmux_window_id: window_id,
      herdr_socket: mux_socket,
      pid: Process.pid
    ))
    at_exit { FileUtils.rm_f(registry_entry) }
  end
end

# Last, on the final arguments: whatever was added above, a launch that would
# break an invariant does not happen. See "Invariants" in sandbox-lib.rb.
git_layout = SandboxLib.git_layout(project_dir)
SandboxLib.check_invariants!(args, git_dirs: git_layout ? [git_layout[:common_dir], git_layout[:git_dir]].uniq : [])

args.push("--", *cmd)

exit SandboxLib.spawn_sandbox(args, cleanup_dir: socket_dir)
