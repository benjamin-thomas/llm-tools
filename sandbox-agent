#!/usr/bin/env ruby

# Symlink to your ~/.local/bin/ directory

# --- Deliberately NOT granted — do not re-add ---
#
# Every mount is a hole in the sandbox. The ones below were big enough to hand
# an agent the host itself, so they are gone on purpose. A broken tool is the
# cheaper trade — if something needs one of these, the answer is no.
#
#   SSH, in every form: ~/.ssh (hidden by the tmpfs home), SSH_AUTH_SOCK, the
#   gnome-keyring and gpg-agent ssh sockets, the ssh/scp/sftp binaries. An
#   agent holding an ssh agent socket can log into every host you can.
#
#   The session D-Bus socket (/run/user/<uid>/bus). It is the Secret Service
#   API: KWallet and gnome-keyring hand out saved passwords over it. This —
#   not the X11 passthrough — is how an agent ends up talking to kwalletd.
#
#   The gnome-keyring socket dir (/run/user/<uid>/keyring): same secrets, plus
#   its ssh agent.
#
#   XDG_CURRENT_DESKTOP / XDG_SESSION_TYPE / DESKTOP_SESSION: their only job
#   was helping Electron apps find an OS keyring, i.e. the thing above.
#
# .sandbox-mounts cannot quietly re-add them: that file lives in the project the
# agent can write, so it authorizes nothing by itself — it requests, and you
# approve with `sandbox-agent allow`. See the "Mount approval" comment in
# sandbox-lib.rb for why this is an approval step and not a denylist.
#
# Still granted, for the record: X11 (clipboard — note any X client can read
# other windows' keystrokes), ~/.password-store + ~/.gnupg ro (commit signing),
# ~/.cache rw, ~/.local ro, audio devices, the project dir rw.

require "fileutils"
require "json"
require "open3"
require "optparse"
require "shellwords"
require "tmpdir"

# The mount set, the floor and the .sandbox-mounts contract live in the lib,
# shared with run-orca-server. What is here is what only an interactive agent
# session needs: the multiplexer, and the flags that drive it.
require_relative "sandbox-lib"

# module_function also defines these as private instance methods, so the
# multiplexer block below can keep calling ro/rw unqualified.
include SandboxLib

flags = { git_rw: nil, mux: "herdr", write: false, mounts: [], setenv: [] }

# `doctor` is a subcommand, not a flag: it takes a project dir and no command.
if (allow = ARGV.first == "allow")
  ARGV.shift
end
if (doctor = ARGV.first == "doctor")
  ARGV.shift
  # `doctor <dir> --write` is the natural order to type, but OptionParser#order!
  # stops at the first positional and would never see the flag. Take it out here
  # so either order works; the parser entry below still handles the other one.
  flags[:write] = true unless ARGV.delete("--write").nil?
end

opam_switch = SandboxLib.detect_opam_switch
opam_path_line = opam_switch ? "path:~/.opam/#{opam_switch}/bin" : "path:~/.opam/<switch>/bin   # e.g. ~/.opam/5.3.0/bin"

parser = OptionParser.new do |opts|
  opts.banner = "Usage: sandbox-agent [flags] <project-dir> -- <command...>"
  opts.separator ""
  opts.separator "Run a CLI agent in a bwrap sandbox. Restricts file access to the"
  opts.separator "project directory only — the agent cannot read or modify anything"
  opts.separator "else under $HOME."
  opts.separator ""

  opts.on("--git-rw", "Allow writing to .git (skips the prompt)") { flags[:git_rw] = true }
  opts.on("--no-git-rw", "Keep .git read-only (skips the prompt). Pass this from",
          "scripts that already asked, so the user is not asked twice") { flags[:git_rw] = false }
  opts.on("--mux MUX", %w[herdr tmux none],
          "Multiplexer for the sandboxed session: herdr (default), tmux, or",
          "none (run the command directly — for servers whose stdout you parse)") do |mux|
    flags[:mux] = mux
    flags[:mux_explicit] = true
  end
  opts.on("--write", "doctor only: append the missing declarations it found") { flags[:write] = true }
  # --mount/--setenv come from the command line, not from .sandbox-mounts, so
  # they are the operator speaking rather than the project. That is the whole
  # reason they exist as flags: a per-instance path (an Orca userData dir, say)
  # has no business being declared in a file the sandboxed agent can edit. The
  # floor still applies to --mount — it costs nothing and keeps one rule.
  opts.on("--mount SPEC", "Extra mount, MODE:SRC or MODE:SRC:DEST (repeatable).",
          "DEST relocates it inside the sandbox, e.g.",
          "rw:~/.local/share/sandbox-orca/foo:~/.config/orca",
          "For operator-supplied paths; projects use .sandbox-mounts") { |spec| flags[:mounts] << spec }
  opts.on("--setenv PAIR", "Extra env var as KEY=VALUE (repeatable)") { |pair| flags[:setenv] << pair }

  opts.separator ""
  opts.separator "Subcommands:"
  opts.separator "  sandbox-agent allow [<project-dir>]   (default: the current directory)"
  opts.separator "    Approve the project's .sandbox-mounts after reading it. Required"
  opts.separator "    before a first launch, and again after any change to the file —"
  opts.separator "    it lives in the project, so an agent can edit it."
  opts.separator ""
  opts.separator "  sandbox-agent doctor <project-dir> [--write]"
  opts.separator "    Report what this project must declare in .sandbox-mounts before it"
  opts.separator "    will run: symlinks that leave the project (which are never mounted"
  opts.separator "    implicitly) plus advisory toolchain recipes. Exits 1 if anything is"
  opts.separator "    undeclared, so it works as a pre-flight check."
  opts.separator ""
  opts.separator "Never available inside the sandbox, by design (see the header comment"
  opts.separator "before re-adding any of it):"
  opts.separator "  SSH — no keys, no agent socket, no ssh/scp/sftp binaries"
  opts.separator "  Session D-Bus + gnome-keyring — the KWallet/Secret Service password API"
  opts.separator "  The host multiplexer server — see the --mux note below"
  opts.separator ""
  opts.separator "The agent always runs inside a sandboxed multiplexer server so sub-agent"
  opts.separator "panes stay confined. Ctrl-o is the prefix either way (with tmux,"
  opts.separator "Alt-left/right switch windows)."
  opts.separator ""
  opts.separator "The default is herdr, which shows per-pane agent state (working /"
  opts.separator "idle / blocked). Its server is reached over a socket that can start"
  opts.separator "processes for whoever holds it, so the sandbox gets a private one via"
  opts.separator "HERDR_SOCKET_PATH and ~/.config/herdr is never mounted — handing an"
  opts.separator "agent the host socket would be a full sandbox escape."
  opts.separator ""
  opts.separator "--mux tmux swaps herdr back for tmux — the multiplexer tmux-orchestrator"
  opts.separator "below drives."
  opts.separator ""
  opts.separator "herdr launches made from inside a host tmux session are recorded in"
  opts.separator "~/.local/state/sandbox-agent (removed on exit) so the host-side companion"
  opts.separator "`herdr-hub` can flag which tmux session's agent needs attention."
  opts.separator ""
  opts.separator "Examples:"
  opts.separator "  sandbox-agent . -- claude-yolo"
  opts.separator "  sandbox-agent /path/to/project -- codex-yolo"
  opts.separator ""
  opts.separator "Multi-agent coordination (tmux-orchestrator, needs --mux tmux):"
  opts.separator "  Launch one agent per tmux window (Ctrl-o c opens a new window), then let"
  opts.separator "  one window act as coordinator and dispatch to / read the others by index"
  opts.separator "  (you never have to name windows):"
  opts.separator "    tmux-orchestrator list                     # session + windows (with indices)"
  opts.separator "    tmux-orchestrator send 2 'do X'            # dispatch to one agent"
  opts.separator "    tmux-orchestrator broadcast 're-review'    # dispatch to every agent"
  opts.separator "    tmux-orchestrator read 2                   # read an agent's output"
  opts.separator "    tmux-orchestrator rename 2 backend         # optional readable label"
  opts.separator ""
  opts.separator "Low-intervention \"yolo\" wrappers (see ~/.local/bin/*-yolo):"
  opts.separator "  sandbox-agent . -- claude-yolo"
  opts.separator "  sandbox-agent . -- codex-yolo"
  opts.separator "  sandbox-agent . -- kimi -y"
  opts.separator "  sandbox-agent . -- grok --always-approve"
  opts.separator "  sandbox-agent . -- opencode       # already yolo by default"
  opts.separator "  sandbox-agent . -- pi             # already yolo by default"
  opts.separator "  sandbox-agent . -- omp            # already yolo by default"
  opts.separator "  sandbox-agent . -- prime-agent    # already yolo by default"
  opts.separator ""
  opts.separator "Auto-mounted when present on the host (no .sandbox-mounts needed):"
  opts.separator "  Chrome/Chromium install dir — for projects driving a CDP browser"
  opts.separator "  /dev/shm tmpfs              — required by Chrome and many tools"
  opts.separator "  Go toolchain + GOPATH       — tracks whichever `go` is on your PATH"
  opts.separator ""
  opts.separator "Projects can provide a .sandbox-mounts file for extra mounts:"
  opts.separator "  ro:/path          — read-only mount"
  opts.separator "  rw:/path          — read-write mount"
  opts.separator "  path:/path/bin    — add to PATH"
  opts.separator "  (leading ~ is expanded to $HOME)"
  opts.separator ""
  opts.separator "Typical .sandbox-mounts recipes (lines below are copy-paste ready):"
  opts.separator ""
  opts.separator "# Haskell (ghcup + cabal)"
  opts.separator "rw:~/.ghcup             # ghcup writes logs/, cache/, tmp/, trash/ (tui needs rw)"
  opts.separator "path:~/.ghcup/bin       # ghc, cabal, hls all live here"
  opts.separator "rw:~/.config/cabal      # cabal config (XDG layout; classic setups: rw:~/.cabal)"
  opts.separator "rw:~/.local/state/cabal # cabal store/logs — overrides the ro ~/.local mount"
  opts.separator "# (the package cache ~/.cache/cabal is auto-mounted)"
  opts.separator ""
  opts.separator "# OCaml (opam)"
  opts.separator "ro:~/.opam"
  opts.separator opam_path_line
  opts.separator ""
  opts.separator "# Node — nvm"
  opts.separator "ro:~/.nvm"
  opts.separator "path:~/.nvm/versions/node/<version>/bin"
  opts.separator ""
  opts.separator "# Node — volta"
  opts.separator "ro:~/.volta"
  opts.separator "path:~/.volta/bin"
  opts.separator ""
  opts.separator "# Node — fnm"
  opts.separator "ro:~/.local/share/fnm"
  opts.separator "path:~/.local/share/fnm/aliases/default/bin"
  opts.separator ""
  opts.separator "# Rust (rustup + cargo)"
  opts.separator "ro:~/.rustup"
  opts.separator "rw:~/.cargo            # cargo writes to registry/cache; use ro: if you prefer"
  opts.separator "path:~/.cargo/bin"
  opts.separator ""
  opts.separator "# Go — auto-detected from your PATH; no entry needed (see list above)"
  opts.separator ""
  opts.separator "# Python — pyenv"
  opts.separator "ro:~/.pyenv"
  opts.separator "path:~/.pyenv/shims"
  opts.separator "path:~/.pyenv/bin"
  opts.separator ""
  opts.separator "# Python — uv"
  opts.separator "rw:~/.cache/uv         # uv needs a writable cache"
  opts.separator "ro:~/.local/share/uv"
  opts.separator "path:~/.local/bin"
  opts.separator ""
  opts.separator "# Python — pipx"
  opts.separator "ro:~/.local/pipx"
  opts.separator "path:~/.local/bin"
end


begin
  parser.order!
rescue OptionParser::ParseError => e
  abort "#{e.message}\n\n#{parser.help}"
end
# `allow` may be given without a path: approving the project you are standing in
# is the common case, and cwd is unambiguous there — unlike a launch, where a
# bare argument could just as well be the command.
project_dir = File.expand_path(ARGV.shift || (allow ? Dir.pwd : abort(parser.help)))
ARGV.shift if ARGV.first == "--"
abort "No command specified.\n\n#{parser.help}" if ARGV.empty? && !doctor && !allow
cmd = ARGV.dup

# --- helpers ---

exit SandboxLib.run_doctor(project_dir, ENV.fetch("HOME"), write: flags[:write]) if doctor
exit SandboxLib.approve_mounts!(project_dir) if allow

# .sandbox-mounts is a request written by the project, not an authorization.
SandboxLib.require_mounts_approval!(project_dir, "sandbox-agent")

# Asked rather than left to memory: the answer is needed before the sandbox
# exists, and inside it the mount can no longer be changed. Same reasoning as
# manage/session, which already asks. A caller that has already asked passes
# --git-rw / --no-git-rw (or sets SANDBOX_AGENT_GIT_RW) so the user is not asked
# twice.
if flags[:git_rw].nil? && !ENV["SANDBOX_AGENT_GIT_RW"].nil?
  flags[:git_rw] = %w[1 true yes y].include?(ENV["SANDBOX_AGENT_GIT_RW"].downcase)
end
if flags[:git_rw].nil?
  flags[:git_rw] =
    if $stdin.tty?
      $stderr.print "Let this session write to .git? [y/N] "
      %w[y yes].include?($stdin.gets.to_s.strip.downcase)
    else
      false
    end
  warn "Starting with .git read-only." unless flags[:git_rw]
end

home = ENV.fetch("HOME")
args = SandboxLib.build_base_args(
  project_dir,
  git_rw: flags[:git_rw],
  headless: false,          # interactive: keep X11 for the clipboard, and audio
  command: cmd.first,
  extra_mounts: flags[:mounts],
  extra_env: flags[:setenv]
)

# --- sandboxed multiplexer server ---
#
# Whichever multiplexer runs, it gets a private server whose socket lives in
# socket_dir. That is not tidiness: a multiplexer server socket is a remote
# control for starting processes, so an agent that reaches the *host* server
# escapes the sandbox through it. tmux is confined via TMUX_TMPDIR, herdr via
# HERDR_SOCKET_PATH; both host sockets are additionally out of reach because
# $HOME is a tmpfs and neither /tmp nor ~/.config/herdr is mounted through.

socket_dir = Dir.mktmpdir("sandbox-agent-")
args.push(*rw(socket_dir))

case flags[:mux]
when "none"
  # No multiplexer: run the command as-is so its stdout reaches our caller
  # unmodified. This exists for long-lived servers whose startup JSON is parsed
  # by a script — `orca serve --recipe-json` prints one pairing object and keeps
  # serving, and a mux in the middle would swallow it. There is no host server
  # to escape to here, so nothing is lost by leaving it out.

when "tmux"
  # tmux never puts its socket directly in TMUX_TMPDIR — it creates a
  # tmux-<uid>/ subdirectory first. Spelling that out here keeps the attach
  # hint below copy-pasteable (the uid is unchanged inside the sandbox: we
  # unshare pid, not user).
  mux_socket = File.join(socket_dir, "tmux-#{Process.uid}", "default")
  attach_hint = "tmux -S #{mux_socket} attach"

  args.push("--setenv", "TMUX_TMPDIR", socket_dir)

  cmd = [
    "tmux", "-f", "/dev/null",
    "set", "-g", "default-terminal", "tmux-256color", ";",
    "set", "-g", "extended-keys", "on", ";",
    "set", "-g", "prefix", "C-o", ";",
    "bind", "C-o", "send-prefix", ";",
    "bind", "-n", "M-left", "prev", ";",
    "bind", "-n", "M-right", "next", ";",
    "new-session", "-s", "sandbox", ";",
    "send-keys", cmd.shelljoin, "Enter",
  ]

when "herdr"
  mux_socket = File.join(socket_dir, "herdr.sock")
  attach_hint = "HERDR_SOCKET_PATH=#{mux_socket} herdr"

  # herdr runs default_shell for every new pane and takes no per-pane command,
  # so the agent is launched through a shim instead. First pane gets the agent
  # (what tmux's send-keys does); later panes get a plain shell, so a pane you
  # open to look around stays a shell rather than starting a second agent.
  launcher = File.join(socket_dir, "launch")
  File.write(launcher, <<~SH)
    #!/bin/sh
    if [ -e "#{socket_dir}/.launched" ]; then
      exec "${SHELL:-/bin/sh}"
    fi
    : > "#{socket_dir}/.launched"
    exec #{cmd.shelljoin}
  SH
  FileUtils.chmod(0o755, launcher)

  # There is no `herdr -f <file>` to match `tmux -f /dev/null`, so settings
  # arrive as a config bind-mounted over the path herdr reads. It is generated
  # rather than copied from the host precisely so ~/.config/herdr — which holds
  # the host server's socket — never has to be mounted.
  #
  # herdr has no "last tab" action; last_pane is the closest built-in. It is a
  # *global* back-and-forth, so returning to a pane in another tab brings that
  # tab with it, and it takes over prefix+l (focus_pane_right) to sit where
  # tmux keeps its last-window binding.
  #
  # A sandbox session is one workspace with a pane or two, so the sidebar is
  # mostly listing what is already on screen: it starts collapsed, and
  # prefix+b brings it back.
  #
  # window_title mirrors the focused agent's own OSC title out to the host
  # tmux (which records it as pane_title, visible in the expanded session
  # switcher): the working spinner for claude, "Action Required" for agents
  # that title their blocked state. The default "{hostname}: {workspace}"
  # would discard exactly that signal. Note "done" never appears in any
  # title — herdr derives it — so herdr-hub, not the title, answers that.
  config = File.join(socket_dir, "config.toml")
  File.write(config, <<~TOML)
    onboarding = false
    [keys]
    prefix = "ctrl+o"
    previous_tab = "alt+left"
    next_tab = "alt+right"
    previous_agent = "alt+up"
    next_agent = "alt+down"
    previous_workspace = "alt+shift+up"
    next_workspace = "alt+shift+down"
    last_pane = "prefix+l"
    [ui]
    sidebar_start_collapsed = true
    window_title = "{terminal_title} | {workspace}"
    [terminal]
    default_shell = "#{launcher}"
  TOML

  args.push(*ro(config, "#{home}/.config/herdr/config.toml"),
            "--setenv", "HERDR_SOCKET_PATH", mux_socket,
            "--setenv", "HERDR_CLIENT_SOCKET_PATH", File.join(socket_dir, "herdr-client.sock"))

  cmd = ["herdr"]
end

if mux_socket
  warn "Sandbox #{flags[:mux]} socket: #{mux_socket}"
  warn "Attach from another terminal:  #{attach_hint}"
  warn "---"
end

# --- host-side registry for herdr-hub ---
#
# Recorded now, on the host, because both facts stop being knowable later:
# which tmux session this launch came from (gone once bwrap starts), and where
# the sandboxed herdr socket lives (the sandbox must never learn the mapping).
# It goes under ~/.local/state — outside every sandbox mount — because
# herdr-hub feeds these values into host tmux commands, and anything under
# socket_dir is agent-writable.
if flags[:mux] == "herdr" && ENV["TMUX"]
  fmt = '#S|#{window_id}' # tmux format tokens, not Ruby interpolation
  out, _err, tmux_status = Open3.capture3("tmux", "display-message", "-p", fmt)
  session, window_id = out.strip.split("|", 2) if tmux_status.success?
  unless session.to_s.empty?
    registry_dir = File.join(home, ".local", "state", "sandbox-agent")
    FileUtils.mkdir_p(registry_dir)
    registry_entry = File.join(registry_dir, "#{File.basename(socket_dir)}.json")
    File.write(registry_entry, JSON.generate(
      project: project_dir,
      tmux_session: session,
      tmux_window_id: window_id,
      herdr_socket: mux_socket,
      pid: Process.pid
    ))
    at_exit { FileUtils.rm_f(registry_entry) }
  end
end

args.push("--", *cmd)

exit SandboxLib.spawn_sandbox(args, cleanup_dir: socket_dir)
