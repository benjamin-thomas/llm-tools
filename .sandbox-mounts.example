# Project-specific extra mounts for sandbox-agent
# Place as .sandbox-mounts at your project root
#
# Formats:
#   ro:/path          — read-only mount
#   rw:/path          — read-write mount
#   path:/path/bin    — add to PATH
#
# Network (the sandbox's network is private; these are its only doors):
#   internet:HOST     — sandbox -> internet: a site it may reach (HTTP/HTTPS,
#                       via a proxy); a name covers its subdomains
#   host:IP:PORT      — sandbox -> host: a service on this machine it may
#                       connect to, e.g. host:127.1.0.2:5432; IP/PREFIX for a
#                       range, PORT,PORT for several ports
#   expose:IP:PORT    — host -> sandbox: a server it runs that the host (your
#                       browser) must reach, e.g. expose:127.1.0.1:3000
#
# Paths starting with ~ are expanded to $HOME.
# Lines starting with # are comments. Blank lines are ignored.
# Non-existent paths are silently skipped.

# Example: Ruby project with rbenv
# rw:~/.rbenv
# rw:~/.bundle
# path:~/.rbenv/shims
# path:~/.rbenv/bin

# Example: Node.js project with nvm
# ro:~/.nvm
# path:~/.nvm/versions/node/v22.19.0/bin

# Example: app secrets
# ro:/run/myapp

# Example: system binary not in /usr
# ro:/opt/google/chrome
