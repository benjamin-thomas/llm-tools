#!/usr/bin/ruby

# Stand-in for xclip inside sandbox-agent, first on the sandbox PATH. The
# sandbox has no access to the host X server, so CLIPBOARD reads and writes go
# through the bridge sandbox-agent serves (see sandbox-x11.rb). PRIMARY is not
# bridged.
#
# /usr/bin/ruby, not `env ruby`: inside a project, `ruby` may be an asdf shim
# pinned to a version that is not installed.

require_relative "../sandbox-x11"

request = SandboxX11.xclip_request(ARGV)
abort "xclip (sandbox): only `-selection clipboard` reads and writes are bridged to the host" unless request

socket = ENV["SANDBOX_CLIPBOARD_SOCKET"]
abort "xclip (sandbox): no clipboard bridge in this session" unless socket && File.socket?(socket)

if request[:mode] == :read
  data = SandboxX11.bridge_call(socket, "READ #{request[:target]}\n")
  exit 1 if data.empty?
  $stdout.binmode.write(data)
else
  data = request[:files].empty? ? $stdin.binmode.read : request[:files].map { |f| File.binread(f) }.join
  data = data.chomp("\n") if request[:rmlastnl]
  SandboxX11.bridge_call(socket, "WRITE #{request[:target]}\n", data)
  $stdout.binmode.write(data) if request[:filter]
end
