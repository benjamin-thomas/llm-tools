#!/usr/bin/ruby

# Symlink to your ~/.local/bin/ directory
#
# Starts opencode's TUI on a model at a variant (its reasoning effort), with
# permissions that no rule denies approved:
#
#   opencode-variant <provider/model> <variant | default>
#
# The TUI takes no --variant: this sets the one it remembers for the model,
# as picking it there would, then starts it. agent-catalog's opencode agents
# run through it.

require_relative "agent-lib"

abort "usage: opencode-variant <provider/model> <variant | default>" unless ARGV.length == 2
model, variant = ARGV
AgentCatalog.remember_opencode_variant(AgentCatalog.opencode_state, model, variant)
exec "opencode", "-m", model, "--auto"
